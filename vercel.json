{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npx turbo run build --filter=web",
  "outputDirectory": "apps/web/.next",
  "rewrites": [
    {
      "source": "/api/server/:path*",
      "destination": "https://squadmap-production.up.railway.app/:path*"
    }
  ]
}
