# Production settings for the backend. Copy to .env on the server and fill in the values.
# Never commit a filled-in copy. Local development needs none of these (see application-local.yml).

SPRING_PROFILES_ACTIVE=prod

# PostgreSQL, as a JDBC URL: jdbc:postgresql://host:5432/dbname
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=

# Redis: redis://:password@host:6379
REDIS_URL=

# Signs access tokens. At least 32 random bytes, for example: openssl rand -base64 48
# Every app instance must use the same value. Changing it signs everyone out.
JWT_SECRET=

# Exact origin(s) of the web app, comma separated, no trailing slash: https://app.example.com
ALLOWED_ORIGINS=

# Where the web app is served. Links in emails point here. No trailing slash.
WEB_BASE_URL=

# Outgoing email over SMTP with STARTTLS (any transactional provider offers this).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender shown on emails, for example: SquadMap <no-reply@example.com>
MAIL_FROM=

# Mapbox token for place search, used only by the server. Create a separate public token with no URL
# restriction (the browser's own token is restricted to the site's address and would be refused here).
MAPBOX_SERVER_TOKEN=

# Push notifications (VAPID). Make a pair once with: node infra/scripts/vapid-keys.mjs
# Keep them for good: changing them silently stops notifications until each person turns them on again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for the push services, for example: mailto:admin@example.com
VAPID_SUBJECT=

# Error reports (optional). Leave empty to send none. From sentry.io: Project settings, Client Keys (DSN).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Health and metrics port, reachable only from the server's own network (never proxied by Nginx).
# Prometheus scrapes http://<app>:8481/actuator/prometheus. Docker health checks use /actuator/health here.
MANAGEMENT_PORT=8481
