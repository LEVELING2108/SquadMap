# Production settings for the backend. Copy to .env on the server and fill in the values.
# Never commit a filled-in copy. Local development needs none of these (see application-local.yml).

SPRING_PROFILES_ACTIVE=prod

# PostgreSQL, as a JDBC URL: jdbc:postgresql://host:5432/dbname
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=

# Redis: redis://:password@host:6379
REDIS_URL=

# Signs access tokens. At least 32 random bytes, for example: openssl rand -base64 48
# Every app instance must use the same value. Changing it signs everyone out.
JWT_SECRET=

# Exact origin(s) of the web app, comma separated, no trailing slash: https://app.example.com
ALLOWED_ORIGINS=
